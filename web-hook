pipeline {
    agent any
    tools {
        maven 'maven3.9'
        jdk 'jdk17'
    }
    stages {
        stage('git checkout') {
            steps {
               git branch: 'main', url: 'https://github.com/shajay3007-DevSecOps/Boardgame-1.git'
            }
        }
        stage('test') {
            steps {
                sh 'mvn test'
            }
        }
          stage('Build') {
            steps {
                sh 'mvn package'
            }
        }
    }
}
